# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Local PostgreSQL connection (running outside Docker)
DATABASE_URL=postgresql://sweety:change_me@localhost:5432/sweety

# Dedicated test database used by Vitest. Must end with "_test".
TEST_DATABASE_URL=postgresql://sweety_test:sweety@localhost:5432/sweety_test

# Authentication. Generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h

# Authentication rate limiting (in-memory, per instance). Defaults: 20 requests per 15 minutes.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# PostgreSQL service used by Docker Compose
POSTGRES_DB=sweety
POSTGRES_USER=sweety
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Host ports used by Docker Compose
SERVER_PORT=5000
CLIENT_PORT=5173

# Vite dev-server proxy target. Docker Compose overrides this with http://server:5000.
VITE_API_PROXY_TARGET=http://localhost:5000
