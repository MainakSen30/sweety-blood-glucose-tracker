# =============================================================================
# SWEETy – Blood Glucose Tracker  |  Environment Configuration Template
# =============================================================================
#
# Copy this file to .env at the repository root and fill in the values:
#
#   cp .env.example .env
#
# IMPORTANT:
#   • .env is git-ignored and must NEVER be committed to the repository.
#   • .env.example IS tracked and must NEVER contain real credentials.
#   • Variables injected by Docker Compose at runtime take precedence over
#     anything you set here when running `docker compose up`.
#
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================

# Node.js runtime mode. Use 'development' locally; 'production' disables
# certain debug helpers and enables the cookie's Secure flag.
# Allowed values: development | test | production
NODE_ENV=development

# TCP port the Express server listens on when running directly on the host
# (outside Docker). Default: 5000.
# Note: macOS AirPlay Receiver also uses port 5000. If the server cannot bind,
# set PORT=5001 and update VITE_API_PROXY_TARGET below.
PORT=5000

# Browser origin allowed by the server's CORS policy.
# In Docker, Compose overrides this to match the container network.
CLIENT_URL=http://localhost:5173

# =============================================================================
# DATABASE
# =============================================================================
#
# Host-local (non-Docker) PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# Examples:
#   postgresql://sweety:change_me@localhost:5432/sweety_dev
#   postgresql://sweety:change_me@localhost:5432/sweety
#
# When running with Docker Compose, Compose constructs DATABASE_URL from the
# POSTGRES_* variables below and injects it into the server container. Use
# 'localhost' for host-local connections and the Docker service name 'postgres'
# inside the Compose network.
#
# Keep DATABASE_URL, POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB
# consistent. Passwords containing URL-reserved characters must be URL-encoded
# when placed in DATABASE_URL.
DATABASE_URL=postgresql://sweety:change_me@localhost:5432/sweety

# Dedicated test database used exclusively by Vitest.
# The database name MUST end with '_test'. The test runner enforces this rule
# and will refuse to run if it does not, ensuring destructive test cleanup
# (TRUNCATE TABLE users CASCADE) can never accidentally target the development
# or demo database.
# This variable is NOT loaded by apps/server/src/config/env.ts; it is read
# directly by apps/server/vitest.config.ts.
TEST_DATABASE_URL=postgresql://sweety_test:change_me@localhost:5432/sweety_test

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Secret key used to sign and verify JSON Web Tokens (HS256).
# REQUIRED. Must be at least 32 characters. The server exits at startup if
# this value is missing or too short.
# Generate a secure value with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# JWT and cookie lifetime. Supports s (seconds), m (minutes), h (hours),
# d (days). Examples: 30m, 1h, 7d. Default: 1h.
JWT_EXPIRES_IN=1h

# =============================================================================
# AUTHENTICATION RATE LIMITING
# =============================================================================
#
# Applied to POST /api/auth/register and POST /api/auth/login.
# Counters are in-process memory; suitable for single-instance deployments.
# Disabled automatically when NODE_ENV=test to keep integration tests
# deterministic.

# Rate-limit window in milliseconds. Default: 900000 (15 minutes).
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Maximum auth requests per IP within the window. Default: 20.
AUTH_RATE_LIMIT_MAX=20

# =============================================================================
# DOCKER COMPOSE — PostgreSQL SERVICE
# =============================================================================
#
# These variables configure the official postgres:17-alpine container.
# They are ONLY used by Docker Compose, not by the Express server directly.
# The server receives a fully-formed DATABASE_URL constructed by Compose from
# these values (using the internal service hostname 'postgres' and port 5432).
#
# If you run PostgreSQL directly on your host (without Docker), set matching
# credentials in DATABASE_URL above and you can leave these values as-is.

# Name of the database created inside the Docker PostgreSQL container.
POSTGRES_DB=sweety

# PostgreSQL role / superuser created inside the Docker container.
POSTGRES_USER=sweety

# Password for the PostgreSQL role. Change this from the placeholder.
# Must match the password in DATABASE_URL when using the Docker DB from the host.
POSTGRES_PASSWORD=change_me

# =============================================================================
# DOCKER COMPOSE — HOST PORT MAPPINGS
# =============================================================================
#
# These control which ports on your host machine map to container-internal ports.
# Container-to-container communication always uses the internal service name
# and port (e.g. postgres:5432, server:5000); only the host-side port changes.
#
# Override when another process already occupies the default port:
#   POSTGRES_PORT=5433   if a local PostgreSQL instance uses 5432
#   SERVER_PORT=5001     if macOS AirPlay uses 5000
#   CLIENT_PORT=5174     (rarely needed)

# Host port mapped to PostgreSQL's container port 5432.
POSTGRES_PORT=5432

# Host port mapped to the Express server's container port 5000.
SERVER_PORT=5000

# Host port mapped to the Vite dev server's container port 5173.
CLIENT_PORT=5173

# =============================================================================
# REDIS REPORT CACHE
# =============================================================================
#
# Redis caches report responses only. PostgreSQL stays the source of truth:
# if Redis is unreachable, reports are computed from PostgreSQL as usual and
# nothing breaks. Cache data is disposable and never authoritative.
#
# Leave REDIS_URL empty to disable report caching entirely.

# Docker Compose connects the server to Redis over the internal network:
REDIS_URL=redis://redis:6379
# Host-local Redis (outside Docker), if you run one:
# REDIS_URL=redis://localhost:6379

# Expiration applied to every cached report, in seconds. Cached reports are
# invalidated after each successful reading mutation; the TTL is the maximum
# time an entry can survive a failed invalidation.
REDIS_CACHE_TTL_SECONDS=60

# =============================================================================
# VITE DEV SERVER
# =============================================================================
#
# The Vite dev server proxies all /api/* requests to this target so the browser
# can use relative /api/... URLs in development.
#
# Host-local value (outside Docker): http://localhost:<PORT>
#   Must match PORT above. If you change PORT to 5001, set this to
#   http://localhost:5001 as well.
#
# Docker Compose overrides this automatically with http://server:5000 so the
# Vite container reaches the Express container over the internal bridge network.
VITE_API_PROXY_TARGET=http://localhost:5000

# =============================================================================
# SEED SCRIPT — DEMO DATA
# =============================================================================
#
# Controls the database seed script (npm run db:seed).
# The seed script creates a demo account and synthetic glucose readings for
# demonstration and evaluation purposes.
#
# Safety restrictions enforced by the seed script:
#   1. NODE_ENV must NOT be 'production'.
#   2. This variable must be exactly 'true' — the npm script does NOT set it
#      automatically. You must supply it explicitly on the command line.
#   3. The database name in DATABASE_URL must be on the explicit allowlist:
#        sweety, sweety_dev, sweety_demo
#      The script explicitly REJECTS test databases (names ending in _test or
#      -test) and any name not on this list.
#   4. No existing passwords are overwritten.
#   5. No data is deleted or truncated.
#   6. All inserts are idempotent (ON CONFLICT DO NOTHING).
#
# How to run (host-local):
#   SEED_DEMO_DATA=true npm run db:seed
#
# How to run (Docker Compose):
#   docker compose exec server sh -c "SEED_DEMO_DATA=true /app/node_modules/.bin/tsx /app/apps/server/src/database/seed.ts"
#
# Demo credentials (documented here for convenience; never use on real accounts):
#   Email   : demo@sweety.local
#   Password: Demo1234!
#
# IMPORTANT: Do NOT set SEED_DEMO_DATA=true permanently in .env.
# Supply it inline only when you intend to run the seed.
# SEED_DEMO_DATA=true
